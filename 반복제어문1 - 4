import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);

        int cnt = 0, sum = 0;

        while (true) {
            int num = s.nextInt();
            if (num == 0) {
                break;
            }
            if (num % 3 != 0 && num % 5 != 0){
                cnt++;
            }
        }
        System.out.print(cnt);
    }
}
