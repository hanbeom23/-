import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);

        int cnt = 0, sum = 0;

        while (true) {
            int num = s.nextInt();
            if (num > 100 || num < 0) {
                break;
            }

            cnt++;
            sum += num;
        }
        
        double avg = (double)sum / cnt;

        System.out.println("sum : " + sum);
        System.out.printf("avg : %.1f\n", avg);
    }
}
