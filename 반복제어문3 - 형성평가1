import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int sum = 0, cnt = 0;

        for (int i = 0; i < 20; i++) {
            int n = sc.nextInt();
            if (n == 0) break;
            sum += n;
            cnt++;
        }

        int avg = (cnt > 0) ? sum / cnt : 0;
        System.out.println(sum + " " + avg);
        sc.close();
    }
}
