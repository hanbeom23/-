import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        int n = s.nextInt();

        for (int i = 0; i < 2 * n - 1; i++) {
            int k = Math.abs(n - 1 - i);

            for (int j = 0; j < n - 1 - k; j++) {
                System.out.print(" ");
            }
            for (int j = 0; j < 2 * k + 1; j++) {
                System.out.print("*");
            }
            System.out.println();
        }
    }
}
