import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);

        double[] a = new double[6];

        for (int i = 0; i < 6; i++) {
            a[i] = s.nextDouble();
        }

        double sum = (a[0] + a[1] + a[2] + a[3] + a[4] + a[5]);
        System.out.printf("%.1f\n", sum / 6);
    }
}
