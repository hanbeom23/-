import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        char[] a = {'J', 'U', 'N', 'G', 'O', 'L'};
        char c = s.next().charAt(0);
        int pos = -1;

        for (int i = 0; i < 6; i++) {
            if (a[i] == c) {
                pos = i;
                break;
            }
        }

        if (pos == -1) {
            System.out.println("none");
        } else {
             System.out.println(pos);
        }
    }
}
