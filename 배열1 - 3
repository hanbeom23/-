import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);

        int[] a = new int[10];
        int odd = 0, even = 0;

        for (int i = 0; i < 10; i++) {
            a[i] = s.nextInt();

            if (i % 2 == 0) {
                odd += a[i];
            } else {
                even += a[i];
            }
        }
        System.out.println("odd : " + odd);
        System.out.println("even : " + even);
    }
}
